{
	"name": "@companion-module/api",
	"license": "MIT",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "run build:schema && run build:root",
		"build:clean": "(rm -rf ./packages/*/dist ./packages/*/*.tsbuildinfo || true) && run build",
		"build:root": "tsc --build tsconfig.json",
		"build:schema": "cd packages/base && node ./tools/generate-manifest-schema.mjs",
		"dev": "run build:root --watch",
		"lint": "eslint .",
		"unit": "vitest run",
		"unit:watch": "vitest"
	},
	"engines": {
		"node": "^22.20 || ^26.5"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@tsconfig/node22": "^22.0.6",
		"@types/node": "^22.20.4",
		"@types/semver": "^7.8.0",
		"eslint": "^10.11.0",
		"prettier": "^3.9.9",
		"typedoc": "^0.28.20",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^4.1.11",
		"vitest-mock-extended": "^4.0.0"
	},
	"packageManager": "yarn@4.18.0"
}
